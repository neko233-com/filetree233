<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX v4/v5 source for the Windows installer.
  Rendered by scripts/package.ps1, which passes:
    ProductVersion  numeric major.minor.build (Windows Installer rejects -alpha suffixes)
    SourcePath      path to the freshly built filetree233.exe
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="filetree233" Language="1033" Manufacturer="neko233"
           Version="$(var.ProductVersion)" Scope="perMachine"
           UpgradeCode="{3e2f0d7c-6b1a-4f4d-9a3c-8f2b5d1e7a60}">
    <MajorUpgrade DowngradeErrorMessage="A newer version of filetree233 is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon.ico" SourceFile="packaging\windows\filetree233.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPCOMMENTS" Value="Disk space explorer and human-confirmed cleanup" />
    <Property Id="ARPHELPLINK" Value="https://github.com/neko233-com/filetree233" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/neko233-com/filetree233" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="filetree233" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Application" Title="filetree233" Level="1">
      <ComponentGroupRef Id="AppComponents" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppComponents" Directory="INSTALLFOLDER">
      <Component Id="Executable" Guid="*">
        <File Source="$(var.SourcePath)" KeyPath="yes" />
        <!-- PATH is restored to its previous value on uninstall. -->
        <Environment Id="InstallFolderOnPath" Name="PATH" Value="[INSTALLFOLDER]"
                     Permanent="no" Part="last" Action="set" System="yes" />
      </Component>
      <Component Id="StartMenu" Guid="*">
        <Shortcut Id="TreemapShortcut" Directory="ProgramMenuFolder" Name="filetree233 treemap"
                  Target="[INSTALLFOLDER]filetree233.exe" Arguments="gui"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" />
        <RemoveFolder Id="RemoveStartMenuFolder" Directory="ProgramMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\neko233\filetree233" Name="startMenu"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <!-- Windows Installer did not publish DisplayIcon from ARPPRODUCTICON here, so
           point Add/Remove Programs at the executable's embedded icon explicitly. -->
      <Component Id="ArpDisplayIcon" Guid="{7c1a4c62-9f0e-4f36-8a2e-2d6e5c9b1a11}" Directory="INSTALLFOLDER">
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\[ProductCode]"
                       Name="DisplayIcon" Type="string" Value="[INSTALLFOLDER]filetree233.exe,0"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
